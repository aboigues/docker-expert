# ✅ SOLUTION - Dockerfile avec Build Secrets
# Démontre l'utilisation sécurisée de secrets pendant le build

FROM node:20-alpine AS deps

WORKDIR /app

COPY package.json package-lock.json* ./

# ============================================
# Méthode 1: Build Secret avec --mount=type=secret
# ============================================
# Le secret est monté temporairement dans /run/secrets/ pendant le build
# Il N'EST JAMAIS inclus dans les layers de l'image
RUN --mount=type=secret,id=npm_token,required=false \
    if [ -f /run/secrets/npm_token ]; then \
        echo "Using private registry with token..."; \
        echo "//registry.npmjs.org/:_authToken=$(cat /run/secrets/npm_token)" > .npmrc; \
    fi && \
    npm ci --only=production && \
    rm -f .npmrc

# Le fichier .npmrc est supprimé après utilisation
# Même si on oubliait de le supprimer, il ne serait pas dans l'image finale
# car on utilise un multi-stage build

# ============================================
# Méthode 2: SSH Mount pour cloner des repos privés
# ============================================
FROM node:20-alpine AS builder

WORKDIR /app

# Install git et openssh (nécessaires pour SSH mount)
RUN apk add --no-cache git openssh-client

# Clone d'un repo privé avec SSH mount
# La clé SSH n'est jamais écrite dans l'image
RUN --mount=type=ssh,required=false \
    mkdir -p /root/.ssh && \
    ssh-keyscan github.com >> /root/.ssh/known_hosts && \
    git clone git@github.com:username/private-repo.git /tmp/private || \
    echo "No SSH key provided, skipping private repo clone"

# ============================================
# Stage final
# ============================================
FROM node:20-alpine AS production

RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

WORKDIR /app

# Copie uniquement les artefacts nécessaires
COPY --from=deps --chown=nodejs:nodejs /app/node_modules ./node_modules
COPY --chown=nodejs:nodejs package.json index.js ./

USER nodejs

EXPOSE 3000

CMD ["node", "index.js"]

# ============================================
# Comment utiliser ce Dockerfile:
# ============================================

# 1. Créer un fichier .npmrc avec votre token:
#    echo "YOUR_NPM_TOKEN" > .npmrc

# 2. Build avec le secret:
#    DOCKER_BUILDKIT=1 docker build \
#      --secret id=npm_token,src=.npmrc \
#      -t app-with-secrets \
#      -f solutions/Dockerfile.secrets \
#      app/private-deps/

# 3. Avec SSH pour repos privés:
#    DOCKER_BUILDKIT=1 docker build \
#      --ssh default \
#      --secret id=npm_token,src=.npmrc \
#      -t app-with-secrets \
#      -f solutions/Dockerfile.secrets \
#      app/private-deps/

# ============================================
# Vérification que les secrets ne sont pas exposés:
# ============================================

# 1. Vérifier l'historique:
#    docker history app-with-secrets
#    # Le token ne doit JAMAIS apparaître

# 2. Exporter l'image et chercher le secret:
#    docker save app-with-secrets | tar -xO | grep -a "NPM_TOKEN" || echo "Secret not found (GOOD!)"

# 3. Inspecter les layers:
#    docker image inspect app-with-secrets

# ============================================
# Points clés de sécurité:
# ============================================
# ✅ Secrets montés temporairement avec --mount=type=secret
# ✅ Secrets jamais écrits dans les layers
# ✅ Suppression explicite des fichiers sensibles après usage
# ✅ Multi-stage build pour isoler les secrets du stage final
# ✅ .npmrc dans .dockerignore pour éviter copie accidentelle
# ✅ Utilisation de BuildKit obligatoire (DOCKER_BUILDKIT=1)
