# ✅ SOLUTION - Build Patterns Avancés
# Démontre les patterns avancés de multi-stage builds

# ============================================
# Build arguments pour metadata
# ============================================
ARG NODE_VERSION=20
ARG BUILD_DATE
ARG VCS_REF
ARG VERSION=1.0.0

# ============================================
# Base stage - Partagé par tous les targets
# ============================================
FROM node:${NODE_VERSION}-alpine AS base

WORKDIR /app

# Install dumb-init
RUN apk add --no-cache dumb-init

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

# ============================================
# Dependencies stage
# ============================================
FROM base AS dependencies

# Copy package files
COPY package.json package-lock.json* ./

# Install ALL dependencies (prod + dev)
RUN --mount=type=cache,target=/root/.npm \
    npm ci

# Install only production dependencies in separate folder
RUN --mount=type=cache,target=/root/.npm \
    npm ci --only=production --prefix /tmp/prod

# ============================================
# Development target
# ============================================
FROM base AS development

# Labels pour le stage development
LABEL stage=development \
      org.opencontainers.image.title="App Development" \
      org.opencontainers.image.description="Development environment with hot-reload"

# Copy all dependencies (including dev)
COPY --from=dependencies /app/node_modules ./node_modules

# Copy source code
COPY . .

# Install additional dev tools
RUN apk add --no-cache git curl vim

# Set development environment
ENV NODE_ENV=development \
    DEBUG=* \
    PORT=3000

EXPOSE 3000

# Use nodemon for hot-reload
CMD ["npm", "run", "dev"]

# ============================================
# Test target
# ============================================
FROM base AS test

# Labels pour le stage test
LABEL stage=test \
      org.opencontainers.image.title="App Test" \
      org.opencontainers.image.description="Test environment"

# Copy all dependencies (including dev for test frameworks)
COPY --from=dependencies /app/node_modules ./node_modules

# Copy source and test files
COPY . .

# Set test environment
ENV NODE_ENV=test \
    CI=true

# Run tests by default
CMD ["npm", "test"]

# ============================================
# Builder stage (pour transpilation TypeScript, webpack, etc.)
# ============================================
FROM base AS builder

COPY --from=dependencies /app/node_modules ./node_modules
COPY package.json ./
COPY . .

# Si vous aviez un build step:
# RUN npm run build

# ============================================
# Production target - Image finale optimisée
# ============================================
FROM base AS production

# ============================================
# OCI Labels (Standard metadata)
# ============================================
LABEL org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.authors="Docker Expert Team" \
      org.opencontainers.image.url="https://github.com/docker-expert/demo" \
      org.opencontainers.image.documentation="https://github.com/docker-expert/demo/README.md" \
      org.opencontainers.image.source="https://github.com/docker-expert/demo" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.vendor="Docker Expert Training" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.title="Express Demo App" \
      org.opencontainers.image.description="Production-ready Express.js application"

# Custom labels
LABEL stage=production \
      app.version="${VERSION}" \
      app.build-date="${BUILD_DATE}" \
      app.vcs-ref="${VCS_REF}" \
      app.node-version="${NODE_VERSION}"

# Copy production dependencies
COPY --from=dependencies --chown=nodejs:nodejs /tmp/prod/node_modules ./node_modules

# Copy application code
COPY --chown=nodejs:nodejs package.json ./
COPY --chown=nodejs:nodejs index.js ./

# Switch to non-root user
USER nodejs

# Environment variables
ENV NODE_ENV=production \
    PORT=3000 \
    VERSION=${VERSION}

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3000/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Use dumb-init and run with node directly
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "index.js"]

# ============================================
# Comment utiliser ce Dockerfile multi-target:
# ============================================

# 1. Build development:
#    docker build --target development -t app:dev .
#    docker run -v $(pwd):/app -p 3000:3000 app:dev

# 2. Build test:
#    docker build --target test -t app:test .
#    docker run app:test

# 3. Build production avec metadata:
#    docker build --target production \
#      --build-arg BUILD_DATE=$(date -u +'%Y-%m-%dT%H:%M:%SZ') \
#      --build-arg VCS_REF=$(git rev-parse --short HEAD) \
#      --build-arg VERSION=1.2.3 \
#      -t app:1.2.3 \
#      -t app:latest \
#      .

# 4. Inspecter les labels:
#    docker image inspect app:latest | jq '.[0].Config.Labels'

# 5. Build multi-platform (avec buildx):
#    docker buildx build --platform linux/amd64,linux/arm64 \
#      --target production \
#      -t app:latest \
#      --push \
#      .

# ============================================
# Avantages de cette approche:
# ============================================
# ✅ Un seul Dockerfile pour tous les environnements
# ✅ Réutilisation maximale des layers (base stage)
# ✅ Développement et production utilisent le même build
# ✅ Metadata complète avec OCI labels
# ✅ Versioning précis avec git hash
# ✅ Images tagées automatiquement
# ✅ CI/CD friendly
# ✅ Multi-platform ready
